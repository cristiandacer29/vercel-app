{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "rewrites": [
        { "source": "/popup-greet.php", "destination": "/api/popup-greet.php" },
        { "source": "/visitor-counter.php", "destination": "/api/visitor-counter.php" },
        { "source": "/(.*)", "destination": "/api/index.php" }
    ]
}